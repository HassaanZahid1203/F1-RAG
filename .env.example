# Copy this file to ".env" and fill in your keys. Never share .env or commit it.

# Which model generates answers (choose names from: python src/check_llm.py)
LLM_PROVIDER=gemini
LLM_MODEL=

# Backup model, used only if the main one stays unavailable (503 errors)
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=openai/gpt-oss-120b

# Which model judges answers during evaluation (Step 7), ideally a different provider
JUDGE_PROVIDER=groq
JUDGE_MODEL=

GEMINI_API_KEY=paste-your-gemini-key-here
GROQ_API_KEY=paste-your-groq-key-here
